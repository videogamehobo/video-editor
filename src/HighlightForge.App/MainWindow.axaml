<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HighlightForge.App.MainWindow"
        Width="1180" Height="720" MinWidth="960" MinHeight="620"
        Title="HighlightForge">
  <Grid RowDefinitions="Auto,*,Auto" Margin="32">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="HighlightForge" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="Local gaming highlights, without sending your footage anywhere." Opacity="0.72" />
      </StackPanel>
      <Border Grid.Column="1" Background="#233A54" CornerRadius="16" Padding="12,5" VerticalAlignment="Top">
        <TextBlock Text="LOCAL ONLY" FontSize="12" FontWeight="SemiBold" />
      </Border>
    </Grid>
    <Border Grid.Row="1" Margin="0,32" Background="#15191F" CornerRadius="12" Padding="40">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="540" Spacing="16">
        <TextBlock Text="Start with an OBS recording" FontSize="24" HorizontalAlignment="Center" />
        <TextBlock Text="HighlightForge will keep your original recordings untouched, inspect their separate audio tracks, and create a reviewable edit draft." TextWrapping="Wrap" TextAlignment="Center" Opacity="0.72" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
          <Button Content="Create a local project" Padding="24,12" Click="CreateProject_Click" />
          <Button Content="Import OBS recording" Padding="24,12" Click="ImportRecording_Click" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Text="Project format, media probe boundary, and local worker are ready." TextWrapping="Wrap" TextAlignment="Center" Opacity="0.55" />
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="2" Text="M0 Foundation • No footage or transcript leaves this device" Opacity="0.52" />
  </Grid>
</Window>
